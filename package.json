{
  "name": "luckytoken",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocols/anthropic": {
      "types": "./dist/protocols/anthropic/index.d.ts",
      "import": "./dist/protocols/anthropic/index.js"
    },
    "./providers/commandcode-private": {
      "types": "./dist/providers/commandcode-private/provider.d.ts",
      "import": "./dist/providers/commandcode-private/provider.js"
    },
    "./providers/commandcode-private/project": {
      "types": "./dist/providers/commandcode-private/project.d.ts",
      "import": "./dist/providers/commandcode-private/project.js"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"vitest.config.ts\"",
    "test": "npm run test:certification && vitest run",
    "test:certification": "node --test test/certification/*.test.mjs",
    "test:unit": "vitest run test/unit --passWithNoTests",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.1",
    "@sindresorhus/slugify": "2.2.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.91.1",
    "@types/node": "24.12.4",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
