{
  "name": "@luckytoken/control-pipe-win-native",
  "version": "0.1.0",
  "private": true,
  "description": "Windows named-pipe byte transport for the LuckyToken control daemon.",
  "main": "index.js",
  "types": "index.d.ts",
  "os": ["win32"],
  "cpu": ["x64"],
  "napi": {
    "name": "lucky_control_pipe_win_native",
    "triples": {
      "defaults": false,
      "additional": ["x86_64-pc-windows-msvc"]
    }
  },
  "scripts": {
    "build": "cargo build --release && node scripts/copy-artifact.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "fmt": "cargo fmt --check",
    "clippy": "cargo clippy --all-targets -- -D warnings",
    "cargo-test": "cargo test"
  }
}
