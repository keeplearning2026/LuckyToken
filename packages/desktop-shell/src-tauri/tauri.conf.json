{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LuckyToken",
  "version": "0.1.0",
  "identifier": "com.luckytoken.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LuckyToken",
        "width": 1080,
        "height": 720,
        "minWidth": 760,
        "minHeight": 540,
        "center": true,
        "visible": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
