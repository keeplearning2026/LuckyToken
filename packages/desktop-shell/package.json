{
  "name": "@token/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "npm run assemble:backend && electron-forge start",
    "dev": "npm run assemble:backend && electron-forge start",
    "clean:electron": "node -e \"require('node:fs').rmSync('.vite',{recursive:true,force:true})\"",
    "generate:icons": "node scripts/generate-icon-containers.mjs",
    "assemble:backend": "npm --prefix ../.. run release:assemble-backend",
    "build": "npm run assemble:backend && npm run clean:electron && electron-forge package",
    "package": "npm run assemble:backend && npm run clean:electron && electron-forge package",
    "make": "npm run assemble:backend && npm run make:prepared",
    "make:prepared": "npm run clean:electron && electron-forge make",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx,mjs}\"",
    "test": "node ../../scripts/run-with-codex-test-sandbox.mjs -- npm run test:inner",
    "test:inner": "vitest run --config vitest.config.mjs",
    "test:e2e": "node ../../scripts/run-with-codex-test-sandbox.mjs -- npm run test:e2e:inner",
    "test:e2e:inner": "npm run build && node --test test/electron-window-lifecycle.e2e.test.mjs",
    "test:product-e2e": "node ../../scripts/run-with-codex-test-sandbox.mjs -- npm run test:product-e2e:inner",
    "test:product-e2e:inner": "npm run build && node --test test/product-golden-journey.e2e.test.mjs",
    "test:product-e2e:run": "node ../../scripts/run-with-codex-test-sandbox.mjs -- npm run test:product-e2e:run:inner",
    "test:product-e2e:run:inner": "node --test --test-concurrency=1 test/first-run-provider-catalog.e2e.test.mjs test/electron-window-lifecycle.e2e.test.mjs test/product-golden-journey.e2e.test.mjs test/provider-activation-journey.e2e.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@token/application-control-plane": "0.1.0",
    "electron-squirrel-startup": "1.0.1",
    "lucide-react": "^1.33.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "electron": "^43.4.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "vite": "8.1.5"
  }
}
