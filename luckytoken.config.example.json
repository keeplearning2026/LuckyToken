{
  "server": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "clientProtocols": {
    "anthropic-messages": {
      "authFile": "client-auth/anthropic-messages.json"
    },
    "openai-responses": {
      "authFile": "client-auth/openai-responses.json",
      "stateFile": "state/openai-responses.json"
    }
  },
  "pi": {
    "directory": "pi"
  },
  "limits": {
    "maxRequestBytes": 1048576,
    "requestTimeoutMs": 120000
  }
}
