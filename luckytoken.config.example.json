{
  "server": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "clientProtocols": {
    "anthropic-messages": {
      "authFile": "client-auth/anthropic-messages.json",
      "conversion": {
        "request": {
          "unknownContent": "error",
          "unresolvedToolCall": "xrepair",
          "localCacheControl": "ignore"
        },
        "response": { "unknownPiContent": "error" }
      }
    },
    "openai-responses": {
      "authFile": "client-auth/openai-responses.json",
      "stateFile": "state/openai-responses.json",
      "conversion": {
        "request": {
          "privilegedMessages": "first",
          "unknownInputItem": "error",
          "orphanToolOutput": "error",
          "unresolvedToolCall": "xrepair",
          "futureReasoningEffort": "max"
        },
        "response": {
          "unknownPiContent": "error",
          "storeFalse": "honor"
        }
      }
    }
  },
  "providerPackages": {
    "@luckytoken/provider-commandcode-private": {
      "conversion": {
        "request": { "syntheticMissingToolResultOutputType": "text" },
        "response": { "pauseTurn": "stop", "unknownEvent": "error" }
      },
      "request": {
        "transport": {
          "timeoutMs": null,
          "maxRetries": 0,
          "maxRetryDelayMs": 60000
        }
      },
      "response": {
        "errorCapture": {
          "bodyReadTimeoutMs": 5000,
          "maxBodyBytes": 65536,
          "maxClientMessageChars": 4096
        }
      }
    }
  },
  "failureLogging": {
    "directory": "logs/failed-requests",
    "detail": "safe",
    "maxFileBytes": 1048576,
    "retentionDays": 30,
    "maxFiles": 1000,
    "logCancellation": true
  },
  "runtimeDiagnostics": {
    "directory": "state/diagnostics"
  },
  "pi": {
    "directory": "pi"
  },
  "limits": {
    "maxRequestBytes": 1048576,
    "requestTimeoutMs": 120000
  }
}
